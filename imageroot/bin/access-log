#!/bin/bash

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

# Print new rows of core.access_log on stdout, one line per row, so they
# reach journald. The last printed access_log_id is kept in a cursor file.

cursor_file=access-log.cursor
interval=10
batch_size=500

run_query() {
    podman exec -i postgres psql -U postgres webtop5 -tA -F $'\t' -v ON_ERROR_STOP=1 <<<"$1"
}

warn() {
    echo "<4>access-log: $*" >&2
}

save_cursor() {
    printf '%s\n' "$1" > "${cursor_file}.tmp" && mv -f "${cursor_file}.tmp" "${cursor_file}" || warn "cannot write ${cursor_file}"
}

# Values are user controlled (a failed login keeps the typed name): replace
# blanks and control chars, so a value cannot split a line or forge a field.
field() {
    echo "coalesce(nullif(regexp_replace($1, '[[:space:][:cntrl:]]', '_', 'g'), ''), '-')"
}

line_expr="'action=' || $(field action)
    || ' domain=' || $(field domain_id)
    || ' user=' || $(field user_id)
    || ' ip=' || $(field "CASE WHEN data IS JSON OBJECT THEN data::json->>'ip' END")
    || ' session=' || $(field session_id)"

table_ready=0

while true; do
    # WebTop creates its schema on first start: wait for it without warnings
    if (( ! table_ready )); then
        if [[ $(run_query "SELECT to_regclass('core.access_log') IS NOT NULL" 2>/dev/null) != t ]]; then
            sleep "${interval}"
            continue
        fi
        table_ready=1
    fi

    if ! max=$(run_query "SELECT coalesce(max(access_log_id), 0) FROM core.access_log"); then
        warn "query failed, retrying in ${interval}s"
        sleep "${interval}"
        continue
    fi

    cursor=$(cat "${cursor_file}" 2>/dev/null)
    # Missing cursor: start from now, old rows are not replayed.
    # Cursor ahead of the table: the database was reset or restored.
    if [[ ! "${cursor}" =~ ^[0-9]+$ ]] || (( cursor > max )); then
        cursor=${max}
        save_cursor "${cursor}"
    fi

    if rows=$(run_query "SELECT access_log_id, ${line_expr}
            FROM core.access_log
            WHERE context = 'AUTH' AND access_log_id > ${cursor}
                AND \"timestamp\" < now() - interval '5 seconds'
            ORDER BY access_log_id
            LIMIT ${batch_size}"); then
        last=${cursor}
        count=0
        while IFS=$'\t' read -r id line; do
            [[ -n "${id}" ]] || continue
            printf '%s\n' "${line}"
            last=${id}
            (( count++ ))
        done <<<"${rows}"
        if (( last != cursor )); then
            save_cursor "${last}"
        fi
        # A full batch means a backlog: read the next one right away
        if (( count == batch_size )); then
            continue
        fi
    else
        warn "query failed, retrying in ${interval}s"
    fi

    sleep "${interval}"
done
