--- a/lib/webtop/Util.php
+++ b/lib/webtop/Util.php
@@ -86,2 +86,18 @@
 	}
+	
+	/*
+	 * A WebTop REST error as the DAV error the phone gets: WebTop's 400, 403
+	 * and 404 as such, anything else (no answer included) as 500. The message
+	 * is ours, never WebTop's response.
+	 * 
+	 * @return \Sabre\DAV\Exception
+	 */
+	public static function toDavException(\Exception $ex, $message) {
+		switch ($ex->getCode()) {
+			case 400: return new \Sabre\DAV\Exception\BadRequest($message);
+			case 403: return new \Sabre\DAV\Exception\Forbidden($message);
+			case 404: return new \Sabre\DAV\Exception\NotFound($message);
+			default: return new \Sabre\DAV\Exception($message);
+		}
+	}
 }
