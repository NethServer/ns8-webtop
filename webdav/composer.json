{
    "name": "sonicle/webtop-dav-server",
    "description": "WebTop DAV Server (CalDAV, CardDAV), built by NethServer for PHP 8.4",
    "keywords": ["WebTop", "CalDAV", "CardDAV", "WebDAV", "sabre/dav"],
    "homepage": "https://github.com/sonicle-webtop/webtop-dav-server",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "lf4php/lf4php": "^4.2.2",
        "lf4php/lf4php-monolog": "^3.1.2",
        "monolog/monolog": "^1.27",
        "hassankhan/config": "^1.0",
        "guzzlehttp/guzzle": "^7.9",
        "sabre/dav": "^4.7.1"
    },
    "autoload": {
        "psr-4": {
            "WT\\": "lib/webtop/",
            "WT\\Client\\Core\\": "lib/webtop-core-client/",
            "WT\\Client\\Calendar\\": "lib/webtop-calendar-client/",
            "WT\\Client\\Contacts\\": "lib/webtop-contacts-client/"
        },
        "files": [
            "package-info.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
