+	// DataURI\Parser::parse() without the data-uri library: the media type and
+	// the raw (decoded) data
+	public static function parseDataUri($dataUri) {
+		if (!preg_match('/data:([a-zA-Z-\/+]*)([a-zA-Z0-9-_;=.+]+)?,(.*)/', $dataUri, $matches)) {
+			throw new \InvalidArgumentException('Could not parse the URL scheme');
+		}
+		$base64 = in_array('base64', explode(';', $matches[2]), true);
+		$data = $base64 ? base64_decode($matches[3]) : rawurldecode($matches[3]);
+		if ($base64 && !$data) {
+			throw new \InvalidArgumentException('base64 decoding failed');
+		}
+		return ['mimeType' => $matches[1] ? $matches[1] : 'text/plain', 'data' => $data];
+	}
