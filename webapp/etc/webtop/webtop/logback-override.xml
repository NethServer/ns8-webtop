<!--
  Loaded by WebTop from override.dir. Send the auth log (logins and
  failed logins with client IP) to stdout, so it reaches journald.
  Own appender: journald already adds the timestamp, and it works
  whatever webtop.log.target is.
-->
<included>
  <appender name="authlog-stdout" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%replace(%msg){'\s+$',''}%n</pattern>
    </encoder>
  </appender>
  <!-- TRACE as upstream: logout and session end events are logged at DEBUG -->
  <logger name="com.sonicle.webtop.AuthLog" level="TRACE" additivity="false">
    <appender-ref ref="authlog-stdout"/>
  </logger>
</included>
